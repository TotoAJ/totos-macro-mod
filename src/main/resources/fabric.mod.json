{
	"schemaVersion": 1,
	"id": "totos-macro-mod",
	"version": "${version}",
	"name": "Toto's Macro Mod",
	"description": "This is a Mace PVP Macro mod because I can't be asked to switch keys really fast.",
	"authors": [
		"TotoAJ"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/totos-macro-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"totoaj.totosmacromod.TotosMacroMod"
		],
		"client": [
			"totoaj.totosmacromod.TotosMacroModClient"
		]
	},
	"mixins": [
		"totos-macro-mod.mixins.json",
		{
			"config": "totos-macro-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"fabric-key-binding-api-v1": "*",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}